# Build artifacts
build/
AutoMixerVST/build/
AutoMixerVST/JUCE/

# Backups
.backup-*/

# Large reference material (books, not source)
*.pdf
*.epub
*.docx
*.exe

# Editor/tooling
.ruff_cache/
.sisyphus/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Generated stems / audio outputs
AutoMixerVST/stems/*
!AutoMixerVST/stems/.gitkeep

# Local LLM model weights — multi-GB, downloaded separately (see redline/llm_classifier.py)
RedLineEngine/models/*.gguf

# PyInstaller build output
RedLineEngine/build/
RedLineEngine/dist/
RedLineEngine/*.spec.bak

# Measured spectral reference profiles (derived from the user's own
# reference tracks — see redline/profile_targets.py)
RedLineEngine/redline/targets/target_*.json

# Machine-local feature flag overrides (see redline/config.py) — never shared
RedLineEngine/.flags.json
.flags.json

# Session / planning artifacts
RedLineEngine/.omo/
RedLineEngine/docs/superpowers/
RedLineEngine/_verify_out/

# Reference books (large, not source)
*.txt
*libgen*

# Test / debug scripts
RedLineEngine/ci_check.py

# Avatar background image (large, not source)
RedLineEngine/app/web/motus_base.png
RedLineEngine/motus_base.png

# Vendored Three.js (large, not actively maintained in repo)
RedLineEngine/app/web/vendor/three/
