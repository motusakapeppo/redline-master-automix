# Build artifacts
build/
AutoMixerVST/build/
AutoMixerVST/JUCE/

# Backups
.backup-*/

# Large reference material (books, not source)
*.pdf
*.epub
*.docx
*.exe

# Editor/tooling
.ruff_cache/
.sisyphus/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Generated stems / audio outputs
AutoMixerVST/stems/*
!AutoMixerVST/stems/.gitkeep

# Local LLM model weights — multi-GB, downloaded separately (see redline/llm_classifier.py)
RedLineEngine/models/*.gguf

# PyInstaller build output
RedLineEngine/build/
RedLineEngine/dist/
RedLineEngine/*.spec.bak

# Measured spectral reference profiles (derived from the user's own
# reference tracks — see redline/profile_targets.py)
RedLineEngine/redline/targets/target_*.json
